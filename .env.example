# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
SMTP_USER=contact@techinnosphere.com
SMTP_PASS=

# Optional: public URL for email open-tracking pixel (e.g. an ngrok URL)
TRACKING_URL=

# Required only for claude-autonomous-agent.mjs
ANTHROPIC_API_KEY=

# Required before exposing email-server.cjs beyond your own Wi-Fi. Generate
# with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=
