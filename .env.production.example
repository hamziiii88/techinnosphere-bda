# Copy to .env.production once you have a live backend URL (e.g. from Render
# — see render.yaml). Vite bakes VITE_* vars into the production build, so
# this only takes effect after `npm run build` / `npm run deploy`, not `npm run dev`.
#
# Without this file, the app falls back to same-host/LAN detection, which
# only works when the frontend and backend are reachable at the same
# address (local dev, phone on the same Wi-Fi as your PC).

VITE_EMAIL_API_BASE=https://your-backend-name.onrender.com
